<?xml version="1.0" encoding="GBK"?>
<project name="149" basedir="." default="all">
  <description>149 Customization Build System</description>
  <property environment="env" />
  <property name="base" location="."/>
  <property name="wthome" location="${env.WT_HOME}"/>
  <property name="bin" location="${wthome}/bin"/>
  <property name="classpath" location="${env.CLASSPATH}"/>
  <property name="wtcodebase" location="${wthome}/codebase"/>

  <target name="all" depends="check_path, i_backup, i_filecopy, i_javagen,i_javac,i_resourcebuild,i_sqlgen"/>
  <target name="buildsrc" depends="check_path, i_backup, i_filecopy,i_javac"/>

	<!--====================================================================-->
    <!--====================================================================-->
    <!--                                                                    -->
    <!-- Initialization                                                     -->
    <!--                                                                    -->
    <!--====================================================================-->
    <!--====================================================================-->
    <target name="init_os">
        <condition property="is_win32">
            <os family="windows"/>
        </condition>
        <condition property="is_unix">
            <os family="unix"/>
        </condition>
    </target>
    <target name="init_win32" depends="init_os" if="is_win32">
        <echo message="initializing win32 commands"/>
        <property name="shell" value="cmd.exe"/>
        <property name="shopt" value="/c"/>
        <property name="ResourceBuild" value="${wthome}\bin\ResourceBuild.bat"/>
        <property name="modelInstall" value="${wthome}\bin\modelInstall.bat"/>
        <property name="xconfmanager" value="${wthome}\bin\xconfmanager.bat"/>
        <property name="JavaGen" value="${wthome}\bin\JavaGen.bat"/>
        <property name="GenModelClass" value="ant -f ${wthome}\bin\tools.xml class -Dclass.source=${base}/src -Dclass.includes="/>
    	<property name="GenSQL" value="ant -f ${wthome}\bin\tools.xml sql_script -Dgen.input="/>
    </target>
    <target name="init_unix" depends="init_os" if="is_unix">
        <echo message="initializing unix commands"/>
        <property name="shell" value="/bin/sh"/>
        <property name="shopt" value=""/>
        <property name="ResourceBuild" value="${wthome}/bin/ResourceBuild.sh"/>
        <property name="modelInstall" value="${wthome}/bin/modelInstall.sh"/>
        <property name="xconfmanager" value="${wthome}/bin/xconfmanager"/>
        <property name="JavaGen" value="${wthome}/bin/JavaGen.sh"/>
        <property name="GenModelClass" value="ant -f ${wthome}\bin\tools.xml class -Dclass.source=${base}/src -Dclass.includes="/>
    	<property name="GenSQL" value="ant -f ${wthome}\bin\tools.xml sql_script -Dgen.input="/>
    </target>

    <target name="check_path" depends="init_win32, init_unix">
        <condition property="path_correct">
            <and>
                <available file="${wthome}/site.xconf"/>
                <available file="${wthome}/codebase/wt.properties.xconf"/>
            </and>
        </condition>
        <!--
        <echo message="wt_home=${wthome}"/>
        <echo message="${path_correct}"/>
        -->
        <fail message="WT_HOME not correct, should work in windchill shell." unless="path_correct"/>
    </target>

    <!--====================================================================-->
    <!-- Copy Non Java and Non Model Files                                  -->
    <!--====================================================================-->
    <target name="fc" depends="check_path, i_filecopy"/>
    <target name="i_filecopy" depends="i_backup" >
      <copy todir="${wtcodebase}" verbose="true" overwrite="true">
		  <fileset dir="${base}/codebase">
		  	<exclude name="ext/casc/conf/config_149.xml"/>
	      	<include name="**/*.*" />
	      	<include name="/com/ptc/windchill/enterprise/search/server/SearchableTypes.properties" />
	      </fileset>
      </copy>
      <copy todir="${wthome}/loadFiles" verbose="true" overwrite="true">
			<fileset dir="${base}/loadFiles">
        		<include name="**/*.zip"/>
        		<include name="**/*.xml"/>
        		<include name="**/*.jsp"/>
			</fileset>
      </copy>
     <copy todir="${wthome}/conf" verbose="true" overwrite="true">
    				<fileset dir="${base}/conf">
    	        		<include name="**/*"/>
    				</fileset>
     </copy>
      <copy todir="${wthome}/loadXMLFiles" verbose="true" overwrite="true">
			<fileset dir="${base}/loadXMLFiles">
        		<include name="**/*.zip"/>
			</fileset>
      </copy>
      <copy todir="${wthome}" verbose="true" overwrite="true">
			<fileset dir="${base}">
        		<include name="**/*.xconf"/>
			</fileset>
      </copy>
      <copy todir="${wthome}" verbose="true" overwrite="true">
			<fileset dir="${base}">
        		<include name="loadFiles/**/*.csv"/>
        		<include name="loadFiles/**/*.xml"/>
			</fileset>
      </copy>
	  <copy todir="${wthome}/src" verbose="true" overwrite="true">
			<fileset dir="${base}/src">
				<include name="ext/casc/**/*.rbInfo"/>
				<include name="ext/ases/**/*.rbInfo"/>
				<include name="wt/**/*.rbInfo"/>
				<include name="ext/ases/**/*.java"/>
			</fileset>
      </copy>
      <copy todir="${wthome}/db" verbose="true" overwrite="true">
			<fileset dir="${base}/db">
				<include name="**/*.sql"/>
			</fileset>
      </copy>
      <copy todir="${wthome}/wtCustom" verbose="true" overwrite="true">
			<fileset dir="${base}/wtCustom">
        		<include name="**/*.rbInfo"/>
			</fileset>
      </copy>
	  <copy todir="${wthome}/tasks" verbose="true" overwrite="true">
			<fileset dir="${base}/tasks">
        		<include name="**/*.xml"/>
			</fileset>
      </copy>
    </target>

    <!--====================================================================-->
    <!-- JavaGen introspect and modelInstall                                -->
    <!--====================================================================-->
    <target name="jg" depends="check_path, i_javagen"/>
    <target name="i_javagen" depends="check_path">
			<exec executable="${shell}">
				<arg line="${shopt} ${GenModelClass} ext/ases/envelope/EnvelopeMemberLink.java"/>
			</exec>
			<exec executable="${shell}">
				<arg line="${shopt} ${GenModelClass} ext/ases/envelope/EnvelopeTopLink.java"/>
			</exec>
			<exec executable="${shell}">
				<arg line="${shopt} ${GenModelClass} ext/ases/envelope/ProcessEnvelope.java"/>
			</exec>
			<exec executable="${shell}">
				<arg line="${shopt} ${GenModelClass} ext/ases/part/ASESHuiqianSignature.java"/>
			</exec>
			<exec executable="${shell}">
				<arg line="${shopt} ${GenModelClass} ext/ases/part/SignActivityLink.java"/>
			</exec>
			<exec executable="${shell}">
				<arg line="${shopt} ${GenModelClass} ext/ases/part/SignLink.java"/>
			</exec>
	</target>


    <!--====================================================================-->
    <!-- Compiling Java Source                                              -->
    <!--====================================================================-->
    <target name="jc" depends="check_path, i_javac"/>
    <target name="i_javac">
        <javac srcdir="${base}/src" destdir="${wtcodebase}" debug="off" encoding="utf-8" verbose="true">
           <classpath>
              <pathelement location="${wthome}/srclib/servlet.jar"/>
            	<fileset dir="${wthome}/codebase/WEB-INF/lib" includes="*.jar"/>
           	    <fileset dir="${wthome}/codebase" includes="*.jar"/>
            	<fileset dir="${wthome}/lib" includes="*.jar"/>
            	<fileset dir="${wthome}/srclib" includes="**/*.jar"/>
            	<fileset dir="${wthome}/installer" includes="*.jar"/>
            </classpath>
        	<include name="com/ptc/extend/**/*.java" /> <!--只是将这一行移至最前，原因未找到-->
			<exclude  name="ext/sast/catalog/GLCatalog.java" />
			<exclude  name="ext/sast/supply/GLSupply.java" />
        	<exclude  name="ext/sast/supply/GLSupplyDescLink.java" />
        	<exclude  name="ext/casc/preview/PreMemberLink.java" />
        	<exclude  name="ext/casc/preview/Preview.java" />
            <exclude  name="ext/casc/preview/PreviewObject.java" />
        	<exclude  name="ext/casc/folder/DynamicAuthorizationProcessor.java"/>
        	<exclude  name="ext/casc/folder/QuickDynamicAuthorizationProcessor.java"/>
        	<exclude  name="ext/ases/technotice/CreateTechNoticeFormProcessor.java"/>
          	<include name="ext/casc/**/*.java" />
          	<include name="ext/ases/**/*.java" />
        	<include name="ext/sast/**/*.java" />
          	<include name="ext/csc/**/*.java" />
          	<include name="ext/ptc/ViewWIHelper.java" />
          	<include name="ext/ptc/workinstruction/WorkInstructionHelper.java" />
          	<include name="com/ptc/core/ui/navigationRB.java" />
			<include name="com/ptc/core/ui/navigationRB_zh_TW.java" />
			<include name="com/ptc/core/ui/navigationRB_zh_CN.java" />
          	<include name="com/ptc/netmarkets/workinstructions/WorkInstructionsUtilities.java" />
          	<include name="com/ptc/windchill/enterprise/object/mvc/builders/HomeAssignmentsComponentBuilder.java" />
			<!--
			<include name="com/ptc/extend/**/*.java" />
			<include name="ext/*.java" />
			-->
        </javac>
    </target>

    <!--====================================================================-->
    <!-- Build rbInfo Resource Files                                        -->
    <!--====================================================================-->
    <target name="rb" depends="check_path, i_filecopy, i_resourcebuild"/>
    <target name="i_resourcebuild">
	    	<exec executable="${shell}">
	    	    <arg line="${shopt} ${ResourceBuild} wt.lifecycle.StateRB true -Dbundle.forceCompile=true"/>
	    	</exec>
	    	<exec executable="${shell}">
	    	    <arg line="${shopt} ${ResourceBuild} wt.project.RoleRB true -Dbundle.forceCompile=true"/>
	    	</exec>
	    	<exec executable="${shell}">
	    	    <arg line="${shopt} ${ResourceBuild} ext.ases.envelope.envelopeResource true -Dbundle.forceCompile=true"/>
	    	</exec>
	    	<exec executable="${shell}">
	    	    <arg line="${shopt} ${ResourceBuild} ext.casc.workflow.tree.resource.asesSignatureResource true -Dbundle.forceCompile=true"/>
	    	</exec>
	    	<exec executable="${shell}">
	    	    <arg line="${shopt} ${ResourceBuild} ext.casc.workflow.workflowResource true -Dbundle.forceCompile=true"/>
	    	</exec>
    		<exec executable="${shell}">
    		   	<arg line="${shopt} ${ResourceBuild} wt.access.accessModelRB true -Dbundle.forceCompile=true"/>
    		</exec>
    		<exec executable="${shell}">
    		    <arg line="${shopt} ${ResourceBuild} wt.access.configuration.SecurityLabel1RB true -Dbundle.forceCompile=true"/>
    		</exec>

    		<exec executable="${shell}">
    		    <arg line="${shopt} ${ResourceBuild} ext.ases.technotice.resource.technoticeRB true -Dbundle.forceCompile=true"/>
    		</exec>
			<exec executable="${shell}">
    		    <arg line="${shopt} ${ResourceBuild} ext.ases.changepackaged.changepackagedResource true -Dbundle.forceCompile=true"/>
    		</exec>


    </target>

	<target name="sqlgen" depends="check_path, i_sqlgen"/>
	<target name="i_sqlgen">
		<exec executable="${shell}">
			<arg line="${shopt} ${GenSQL} ext.ases.*"/>
		</exec>
	</target>

	<!--====================================================================-->
	<!-- Backup Original Classes / Jsp                                      -->
	<!--====================================================================-->
	<target name="backup" depends="check_path, i_backup"/>
	<target name="i_backup">

	</target>

	<!--====================================================================-->
	<!-- Clean                                                              -->
	<!--====================================================================-->
	<target name="clean" depends="check_path">

    </target>

</project>
