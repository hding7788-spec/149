<%@ page import="ext.casc.tools.CustomStringJavaCompiler" %><%@ page import="org.json.JSONObject" %><%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%><head>    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">    <meta http-equiv="X-UA-Compatible" content="IE=edge" />    <%        String path = request.getContextPath();        String basePath = request.getScheme()+"://"+request.getServerName()+":"+request.getServerPort()+path+"/";    %>    <link rel="stylesheet" type="text/css" href="<%= basePath%>netmarkets/javascript/ext/resources/css/ext-all.css" />    <script type="text/javascript" src="<%= basePath%>netmarkets/javascript/ext/adapter/ext/ext-base.js"></script>    <script type="text/javascript" src="<%= basePath%>netmarkets/javascript/ext/ext-all.js"></script>    <script type="text/javascript">        Ext.onReady(function(){            var items=[{                region:'center',                xtype:'textarea',                autoScroll:true,                id:'code'            },{                region:'south',                xtype:'textarea',                autoScroll:true,                height:200,                id:'msg'            }];            var errWin = new Ext.Window({                title:'在线代码调试',                modal:true,                closable:false,                layout:'border',                items:items,                buttons : [{                    text:'提交',                    handler:function(){                        Ext.Ajax.request({                            url:'/Windchill/netmarkets/jsp/ext/tools/debugOnline.jsp',                            timeout:60*60*1000,                            params:{                                code:Ext.getCmp('code').getValue()                            },                            success:function (response){                                var result = Ext.decode(response.responseText);                                Ext.getCmp('msg').setValue(result.msg);                            }                        })                    }                }]            });            errWin.show();            errWin.maximize();        });    </script></head>