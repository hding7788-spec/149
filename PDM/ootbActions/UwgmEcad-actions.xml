      windowType="popup" />
	  <moreurlinfo>height=600,width=670</moreurlinfo>
    </action>

    <action name="defineDesign" required="true" preloadWizardPage="true" >
      <component name="document.defineDesign" typeBased="true" windowType="wizard_step" />
    </action>

    <action name="setSchematicAttributes" required="true" preloadWizardPage="false" hidden="true" beforeJS="setSchematicAttributesBefore" afterVK="setAttributesWizStep">
      <command windowType="wizard_step" />
    </action>

    <action name="setBoardAttributes" preloadWizardPage="false" required="true" hidden="true" beforeJS="setBoardAttributesBefore" afterVK="setAttributesWizStep">
