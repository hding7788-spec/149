<?xml version="1.0"?>
<!DOCTYPE actionmodels SYSTEM '../../actionmodels.dtd'>

<!-- define the actions on the UI components -->
<actionmodels>
   <model name="subscription table actions" >
      <action name="deleteSubscription"      type="subscription" shortcut="true"/>
      <action name="unsubscribeSubscription" type="subscription" shortcut="true"/>
   </model>
   <model name="object subscription table actions" >
      <action name="deleteSubscription"                type="subscription" shortcut="true"/>
      <action name="unsubscribeSubscription"           type="subscription" shortcut="true"/>
      <action name="separator"                         type="separator" shortcut="true"/>
      <action name="createSubscriptionObjSubscrAddRow" type="subscription" shortcut="true"/>
   </model>
   <model name="subscription row actions">
      <action name="object"                type="view"/>
      <action name="deleteSubscriptionRow" type="subscription"/>
      <action name="unsubscribeRow"        type="subscription"/>
      <action name="editSubscription"      type="subscription"/>
   </model>
   <model name="subscription tln row actions">
      <action name="object"                type="view"/>
      <action name="deleteSubscriptionRow" type="subscription"/>
      <action name="unsubscribeTlnRow"     type="subscription"/>
      <action name="editSubscription"      type="subscription"/>
   </model>
   <model name="subscription info actions">
      <action name="deleteSubscriptionInfo"      type="subscription"/>
      <action name="unsubscribeSubscriptionInfo" type="subscription"/>
      <action name="editSubscription"            type="subscription"/>
   </model>
   
   <!-- customized nav menu bar for subscriptions -->
   <model name="subscription_customized_nav" defaultActionName="attributes" defaultActionType="object">  
      <action name="attributes" type="object"/>
      <action name="primaryAttributes"      type="object"/>
      <action name="subscriptionRecipients" type="subscription"/>
      <action name="subscriptionSubscribedObjects" type="subscription"/>
   </model>

   <model name="SubscriptionInfoPageTabset" resourceBundle="com.ptc.core.subscription.subscriptionResource">
      <submodel name="SubscriptionInfoDefaultDetailsTab"/> 
      <submodel name="SubscriptionInfoRecipientsTab"/>
      <submodel name="SubscriptionInfoSubscribedObjectsTab"/> 
   </model>

   <model name="SubscriptionInfoDefaultDetailsTab" resourceBundle="com.ptc.core.subscription.subscriptionResource">
      <action name="primaryAttributes" type="object"/>
      <action name="attributes" type="object"/> 
   </model>

   <model name="SubscriptionInfoRecipientsTab" resourceBundle="com.ptc.core.subscription.subscriptionResource">
      <action name="subscriptionRecipients" type="subscription"/> 
   </model>

   <model name="SubscriptionInfoSubscribedObjectsTab" resourceBundle="com.ptc.core.subscription.subscriptionResource">
      <action name="subscriptionSubscribedObjects" type="subscription"/> 
   </model>

</actionmodels>