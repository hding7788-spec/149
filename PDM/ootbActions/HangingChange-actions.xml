<?xml version="1.0"?>
<!DOCTYPE listofactions SYSTEM '../../actions.dtd'>
<listofactions>
   <objecttype name="hangingChanges" class="wt.fc.Persistable" resourceBundle="com.ptc.windchill.enterprise.hangingChanges.hangingChangesActionsRB">
     <action name="addHangingChange" selectRequired="true" ajax="row" renderType="GENERAL">
         <description>Add hanging change</description>
         <command onClick="ptcChgLAH.handleToolbarAction(event,false,false)" class="com.ptc.windchill.enterprise.hangingChanges.commands.HangingChangeCreateCommands" method="execute"/>
      </action>
      <action name="viewUnincorporatedChanges" >
       <description>View unincorporated changes</description>
       <command windowType="new"/>
      </action>
      <action name="editUnincorporatedChanges" >
         <description>Edit unincorporated changes</description>
         <command windowType="new"/>
      </action>
      <action name="unincorporatedChangesStep" >
          <description>Unincorporated changes wizard step</description>
          <command windowType="wizard_step"/>
      </action>
      <action name="setPlannedRevision"  selectRequired="true">
          <description>Set the planned revision</description>
          <command windowType="popup" url="netmarkets/jsp/util/revisionLabelPicker.jsp"/>
       </action>
   </objecttype>
</listofactions>