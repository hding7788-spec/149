<?xml version="1.0"?>
<!DOCTYPE actionmodels SYSTEM 'actionmodels.dtd'>
<!-- define the actions on wt.doc.WTDocument -->
<actionmodels>

   <model name="wt.doc.WTDocument.msoi">
      <action name="search" type="object"/>
      <action name="createFromTemplateWizard" type="document"/>
      <action name="create" type="document"/>
      <action name="createMulti" type="document"/>
      <action name="createDocTemplate" type="document"/>
      <action name="separator" type="separator"/>
      <action name="checkout" type="object"/>
      <action name="checkout_and_download" type="wip"/>
      <action name="undocheckout" type="object"/>
      <action name="REVISEITEMS" type="pdmObject"/>
      <action name="edit" type="document"/>
      <action name="checkoutAndEdit" type="document"/>
      <action name="checkin" type="workinprogress"/>
      <action name="replace_content" type="wip"/>
      <action name="renameDocumentWizard" type="document"/>
      <action name="MULTI_OBJ_DELETE" type="pdmObject"/>
      <action name="separator" type="separator"/>
      <action name="download_primary_attachment" type="attachments"/>
      <action name="dti_get_attributes" type="msoi"/>
      <action name="view" type="object"/>
      <action name="setState" type="lifecycle"/>
      <action name="create"   type="promotionRequest"/>
  </model>
  
  <model name="DTI.Explorer.Document.SingleSelect.RMB">
         <action name="view"   type="object"/>    <!-- Info page -->
         <action name="download_primary_attachment"   type="attachments"/>
         <action name="redirect_primary_attachment"   type="attachments"/>
         <action name="checkin"                type="wip"/>       <!-- Check In -->
         <action name="checkout"               type="object"/>    <!-- Check Out -->
         <action name="checkout_and_download"  type="wip"/>       <!-- Check Out and Download -->
         <action name="checkoutAndEdit"        type="document"/>  <!-- Check Out and Edit -->
         <action name="undocheckout"           type="object"/>    <!-- Undo Checkout -->
         <action name="edit"                   type="document"/> <!-- Edit -->
         <action name="REVISEITEMS"            type="pdmObject"/> <!-- Revise -->  
         <action name="renameDocumentWizard"   type="document"/>  <!-- doc specific Rename --> 
         <action name="setState"               type="lifecycle"/> <!-- Set State -->
         <action name="MULTI_OBJ_DELETE"       type="pdmObject"/> <!-- Delete -->
         <action name="reassignLC"             type="lifecycle"/>    <!-- Reassign Life Cycle -->
         <action name="create"                 type="promotionRequest"/> <!-- Promote --> 
         <action name="ManageSecurity"     type="accessPermission"/> <!-- Edit Access Control -->
         <action name="EDITSECURITYLABELS" type="object"/>  <!-- Edit Security Label -->
  </model>

  <model name="DTI.Explorer.Folder.SingleSelect.RMB">
		 <action   name="edit"                 type="folder" />                   <!-- Edit -->
		 <action name="MULTI_OBJ_DELETE" type="pdmObject" />      <!-- multiObject Delete -->
         <action name="ManageSecurity"     type="accessPermission"/> <!-- Edit Access Control -->
         <action name="EDITSECURITYLABELS" type="object"/>  <!-- Edit Security Label -->
  </model>
  
  <model name="DTI.Explorer.MultiSelect.RMB">
         <action name="MULTI_OBJ_DELETE" type="pdmObject" />      <!-- multiObject Delete -->
  </model>
  
  <model name="DTI.Explorer.Link.SingleSelect.RMB">
  	<action name="edit_bk" type="bookmark"/>
  	<action name="delete"       type="bookmark"/> <!-- Delete -->
  </model>
  
  <model name="DTI.Explorer.Document.MultiSelect.RMB">
	     <action name="SETSTATE"                type="pdmObject"/> <!-- Set State -->
	     <action name="multiObjectCheckIn"      type="wip" />      <!-- multiObject CheckIn -->
	     <action name="multiObjectCheckOut"     type="wip"/>       <!-- Check out -->
	     <action name="multiObjectUndoCheckout" type="wip" />      <!-- multiObject UndoCheckout -->
		 <action name="MULTI_OBJ_DELETE" type="pdmObject" />       <!-- multiObject Delete -->
  </model>
  
  <model name="wt.meeting.TraditionalMeeting.msoi">
      <action name="create" type="meeting"/>
      <action name="cancel" type="meeting"/>
  </model>
  <model name="wt.meeting.MeetingCenterMeeting.msoi">
      <action name="create" type="meeting"/>
      <action name="cancel" type="meeting"/>
  </model>
  <model name="third_level_nav_dti" defaultActionName="attributes" defaultActionType="object">
       <action name="attributes"                            type="object"/>
       <action name="primaryContent"                        type="object"/>     
       <action name="attachments"                           type="object"/>
  </model>

  <model name="DTIInfoPageWizardButtons">
            <action name="moreInfoButton"  type="msoi"/>
            <action name="closeButton"  type="object"/>
    </model>

</actionmodels>
