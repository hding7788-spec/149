        <action name="showZip" type="SoftwareBuild"/>
        <action name="primaryContent" type="object"/>  
        <action name="attachments" type="object"/>        
     </model>
     
    <!-- Upload ReceivedDelivery Files wizard toolbar actions -->
    <model name="third_level_nav_rd">
        <submodel name="general"/>                            <!-- General -->                           
        <action name="rdAdditionalContent" type="rd"/> 
