    <action name="setGenericAttributes" required="true" preloadWizardPage="false" hidden="true" beforeJS="setGenericAttributesBefore" afterVK="setAttributesWizStep">
      <command windowType="wizard_step" />
    </action>

    <action name="addSchematicDerivedObject" >
      <command onClick="addNewRow(table.id,'schematic')" ></command>
    </action>

    <action name="addSchematicMultipleDerivedObjects" >
      <command onClick="add5NewRows(table.id,'schematic')" ></command>
    </action>

    <action name="addBoardDerivedObject" >
      <command onClick="addNewRow(table.id,'board')" ></command>
    </action>

    <action name="addBoardMultipleDerivedObjects" >
      <command onClick="add5NewRows(table.id,'board')" ></command>
    </action>

    <action name="setDerivedObjects" ajax="row" id="setDerivedObjects" preloadWizardPage="false"  required="true" hidden="true" afterJS="validateDerivedObjectsStep">
      <command windowType="wizard_step" url="netmarkets/jsp/document/setDerivedObjects.jsp"/>
    </action>

    <action name="addScematicDerivedObjects" required="false" preloadWizardPage="false" hidden="true" >
      <component name="document.addScematicDerivedObjects" typeBased="true" windowType="wizard_step"/>
    </action>

    <action name="addBoardDerivedObjects" required="false" preloadWizardPage="false" hidden="true" >
      <component name="document.addBoardDerivedObjects" typeBased="true" windowType="wizard_step"/>
    </action>

