<?xml version="1.0"?>
<!DOCTYPE listofactions SYSTEM 'actions.dtd'>
<listofactions>

    <objecttype name="fba" class="wt.org.WTUser" resourceBundle="com.ptc.fba.fbaRB">

        <action name="signOut" enabledwhensuspended="true">
            <command windowType="page" onClick="doSignOut('wtcore/jsp/logout.jsp')"/>
            <includeFilter name="hideNonFormBasedAuthentication"/>
            <includeFilter name="hideCreoEmbeddedBrowser"/>
        </action>

    </objecttype>

</listofactions>