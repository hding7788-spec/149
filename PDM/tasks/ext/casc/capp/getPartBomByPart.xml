    <ie:param name="OBJECT_REF" data="${part[0]obid[0]}"/>
    <ie:param name="DIRECTION" data="uses"/>
    <ie:param name="AUTO_NAVIGATE" data="true"/>
    <ie:param name="DEPTH" data="4"/>
    <ie:param name="MODE" data="nested"/>
    <!ie:param name="SELECTBY" data="LATEST"/>
    <ie:param name="GROUP_OUT" data="queryTree"/>
	<ie:param name="OUTPUT_TYPE" data="FULL"/>
    <ie:param name="Attribute" data="quantity.amount"/>
    <ie:param name="Attribute" data="number"/>
    <ie:param name="Attribute" data="name"/>
    <ie:param name="Attribute" data="view"/>
    <ie:param name="Attribute" data="version"/>
    <ie:param name="Attribute" data="state.state"/>
    <ie:param name="Attribute" data="creator.name"/>
    <ie:param name="Attribute" data="CTYPE"/>
