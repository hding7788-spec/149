# 允许匿名访问启动编辑器需要的 .jar 文件
<LocationMatch "^/Windchill/((lib/)?[^/]+\.jar(?:;.*)?|wt/security/security.jar(?:;.*)?|install/boot.jar(?:;.*)?)$">
    Require all granted
</LocationMatch>

<LocationMatch "^/Windchill/.+\\.class(;.*)?">
    Require all granted
</LocationMatch>

# 输入http://域名/ 可以浏览文件列表
DocumentRoot "/pdm/ptc/Windchill_11.0/Windchill/tmp/IXBExpImp"
<Directory "/pdm/ptc/Windchill_11.0/Windchill/tmp/IXBExpImp">
    Options Indexes FollowSymLinks
    AllowOverride None
    Require all granted
</Directory>