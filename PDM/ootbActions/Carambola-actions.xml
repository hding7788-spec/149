    <objecttype name="carambola">
        <action name="onclickIsInvalid">
            <description>
                This action illustrates how an invalid onclick action is handled when parsed by the action service.
                Such invalid actions should not prevent the page from being displayed.
            </description>
            <command onClick="doFoo('unterminated string)"/>
            <label>Action Has Invalid Onclick</label>
            <icon>netmarkets/images/ladybug.png</icon>
            <tooltip>Action has invalid onclick</tooltip>
        </action>
        <action name="onclickToBeWrapped">
            <description>
                This action illustrates how invalid onclick actions with multiple javascript function calls are
                handled by the action service.  Onclick actions should just be a single function call.
                The function can return either true or false, depending on whether the action should be executed or not.
                If an onclick action with multiple statements is found, the framework wraps the statements in a single function call
                so the page will not be prevented from displaying.

                This onclick will be converted to:
                if(function(){alert('Hello');Event.stop(event);return false;}()) { //proceed with action...}
            </description>
            <command onClick="alert('Hello');Event.stop(event);return false;" windowType="page"/>
            <label>Action Has Complex Onclick</label>
            <icon>netmarkets/images/ladybug.png</icon>
            <tooltip>Action has complex onclick</tooltip>
        </action>
    </objecttype>

