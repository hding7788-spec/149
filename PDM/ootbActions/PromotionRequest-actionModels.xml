<?xml version="1.0"?>
<!DOCTYPE actionmodels SYSTEM '../../actionmodels.dtd'>
<!-- define the actions on the UI components -->
<actionmodels>

   <model name="promotion request row actions" menufor="wt.maturity.PromotionNotice">
      <description>Promotion notice row actions</description>
      <submodel name="promotion request row actions open"/>
      <action name="separator"                    type="separator"/>
      <action name="view"                         type="object"/>
      <action name="separator"                    type="separator"/>
      <action name="edit"                         type="promotionRequest"/>
      <action name="delete"                       type="promotionRequest"/>
      <action name="separator"                    type="separator"/>
      <action name="reassignLC"                   type="lifecycle"/> <!-- Reassign Life Cycle -->
      <action name="resetTeam"                    type="team"/>
      <action name="separator"                    type="separator"/>
      <action name="CONTAINERMOVE"                type="pdmObject"/>
      <action name="ManageSecurity"               type="accessPermission"/>
      <action name="securityLabelsSingleObjJCA"   type="securityLabels"/>
      <action name="createSubscription"           type="subscription"/>     
   </model>

   <model name="promotion request row actions open" resourceBundle="com.ptc.windchill.enterprise.maturity.promotionRequestActionsRB">
       <action name="openInMobileApp" type="object"/>     <!-- Open in Mobile App -->
       <action name="sysnavTabShortcut" type="sysnav"/>   <!-- Open Info Page in Relationship Explorer Tab-->
   </model>

   <model name="third_level_nav_promotionRequest" defaultActionName="promotionItemsTable" defaultActionType="promotionRequest" >
      <description>Third level nav for promotion request with default action promotion items table</description>
      <submodel name="general"/>
      <submodel name="relatedItems"/>
      <submodel name="history"/>
      <submodel name="collaboration"/>
   </model>

   <model name="promotionRequest promotionItems table">
      <description>Toolbar actions for the problem reports, variances, change requests, and change notices tables under the change menu</description>
      <action name="list_copy"           type="object" shortcut="true"/>
   </model>

   <model name="promotionRequest wizard promotionItems table">
      <description>Toolbar actions for the problem reports, variances, change requests, and change notices tables under the change menu</description>
      <action name="promoteObjects"      type="promotionRequest"/>
      <action name="list_copy"           type="object" shortcut="true"/>
      <action name="paste"			     type="promotionRequest" shortcut="true"/>
      <action name="pasteSelect"		 type="promotionRequest"/>
      <action name="remove"              type="promotionRequest" shortcut="true"/>
      <action name="collectBaselineItems" type="promotionRequest" shortcut="true"/>
      <action name="addPromotables"      type="promotionRequest" shortcut="true"/>
   </model>


   <model name="promotionRequest promotionItems row actions">
      <description>Toolbar actions for the promotion objects table on the promotion request info page</description>
      <action name="view"                type="object" />
      <action name="separator"           type="separator"/>
      <action name="OPENINPROE"          type="pdmObject"/>
      <action name="OPENINCADTOOL"       type="pdmObject"/>
      <action name="OPENINARBORTEXT"     type="epmdocument"/>
      <action name="openProductView"     type="wvs"/>
      <action name="separator"           type="separator"/>
      <action name="WFDOWNLOAD"          type="pdmObject"/>
   </model>

   <model name="promotionPreference.toolbar.actions">
        <description>Toolbar actions for promotion preferences table</description>
        <action name="createPromotionPreference" type="promotionRequest" shortcut="true"/>
   </model>

   <model name="promotionRequest participants toolbar actions">
        <action name="explode" type="folder"/>
        <action name="implode" type="folder"/>
   </model>

   <!-- Tabs for Promotion Request Info Page -->
   <model name="promotionRequestInfoPageTabSet" >
      <submodel name="promotionRequestDetailsTab"/>
      <submodel name="promotionRequestProcessTab"/>
      <submodel name="promotionRequestHistoryTab"/>
      <action name="sysnavTab" type="sysnav"/>
   </model>

   <model name="promotionRequestDetailsTab" resourceBundle="com.ptc.windchill.enterprise.maturity.promotionRequestActionsRB">
      <action name="primaryAttributes"   type="object"/>
      <action name="attributes"          type="object"/>
      <action name="promotionItemsTable" type="promotionRequest"/>
   </model>

   <model name="promotionRequestProcessTab" resourceBundle="com.ptc.windchill.enterprise.maturity.promotionRequestActionsRB">
      <action name="listTeamCC"     type="team"/>
      <action name="processHistory" type="workflow"/>
      <action name="discuss"             type="forum"/>
   </model>

   <!-- History tab for promotion request -->
   <model name="promotionRequestHistoryTab" resourceBundle="com.ptc.windchill.enterprise.maturity.promotionRequestActionsRB">
      <action name="maturityHistory" type="history"/>
   </model>
   
   <model name="PromotionNotice_WfTask" resourceBundle="com.ptc.windchill.enterprise.maturity.promotionRequestActionsRB">
        <action name="attributes" type="workitem"/>
        <action name="routingStatus" type="workitem"/>
        <action name="workflowTaskPboAttributes" type="object"/>
        <action name="saveComplete" type="workitem"/>
        <action name="workItemProcessVariables" type="workitem"/>
        <action name="workItemSignOffComponent" type="workitem"/>
        <action name="reviewApproveTask_PromotionObjectsTable" type="promotionRequest"/>
   </model>

 </actionmodels>