<%@ page import="ext.casc.tools.CustomStringJavaCompiler" %><%@ page import="org.json.JSONObject" %><%@ page  pageEncoding="UTF-8"%>    <%        String code = request.getParameter("code");        JSONObject result = new JSONObject();        if(code!=null &&!"".equals(code)){            CustomStringJavaCompiler compiler = new CustomStringJavaCompiler(code);            boolean res = compiler.compiler();            StringBuilder info = new StringBuilder();            if(res){                info.append("编译成功\n");                info.append("编译时间：\n").append(compiler.getCompilerTakeTime()).append("\n");                try{                    compiler.runMainMethod();                    info.append("运行时间:").append(compiler.getRunTakeTime()).append("\n");                }catch (Exception e){                    info.append("运行异常:").append(e.getLocalizedMessage()).append("\n");                    e.printStackTrace();                }                info.append(compiler.getRunResult()).append("\n");            }            result.put("success",true);            result.put("msg",info.toString());            response.getWriter().write(result.toString());        }    %>