<?xml version="1.0"?>
<!DOCTYPE listofactions SYSTEM 'actions.dtd'>
<listofactions>

   <objecttype name="explorer">
      <action name="launchPSE" uicomponent="PSE"
         resourceBundle="com.ptc.windchill.explorer.productstructure.server.productStructureResource">
         <command
            url="netmarkets/jsp/explorer/launchExplorer.jsp?appId=ptc.pdm.ProductStructureExplorer"
            windowType="popup" />
         <includeFilter name="psbSessionValidation" />
         <includeFilter name="hideForNewObjectInWorkspace" />
         <includeFilter name="sandboxSharingValidationSimple" />
      </action>
   </objecttype>

   <objecttype name="explorer">
      <action name="launchEmptyPSE" uicomponent="PSE"
         resourceBundle="com.ptc.windchill.explorer.productstructure.server.productStructureResource">
         <command
            url="netmarkets/jsp/explorer/launchExplorer.jsp?appId=ptc.pdm.ProductStructureExplorer&amp;launchEmpty=true"
            windowType="popup" />
      </action>
   </objecttype>

</listofactions>