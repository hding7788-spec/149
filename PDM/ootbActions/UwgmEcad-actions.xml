     <action name="createPartFromBOMEditor" uicomponent="CREATE_PART" ajax="row">
       <command class="com.ptc.windchill.uwgm.cadx.EcadActions.CreatePartFromBOMEditorFormProcessor" method="execute" windowType="popup" 
       url="/netmarkets/jsp/part/createPartWizard.jsp"/>
       <includeFilter name="showNewActionPreValidation"/>
	     <moreurlinfo>height=620,width=620</moreurlinfo>
     </action>
    <action name="removeRowsDerived" renderType="GENERAL" selectRequired="true">
