    <action name="separator" type="separator"/>   <!-- Seperator -->
    
    <action name="multireassign" type="work" />
    <action name="multiaccept" type="work" />
    <action name="multiunaccept" type="work" />
    <action name="separator" type="separator"/>   <!-- Seperator -->
    
    <action name="MULTIEDITSECURITYLABELS"       type="object"/>    <!-- Edit Security Labels -->
    <action name="createSubscription" type="subscription" /><!-- Subscribe -->
   </model>

   <model name="new_submenu" resourceBundle="com.ptc.windchill.enterprise.search.client.searchClientResource">
    <description>Actions in submenu New</description>
    <action name="create" type="changeNotice"/>
    <action name="create" type="changeRequest"/>
    <action name="create" type="problemReport"/>
    <action name="create" type="variance"/>
    <action name="create" type="promotionRequest" /> <!-- New Promotion request -->
    <action name="createUDI" type="udi"/> <!-- New UDI Submission -->
   </model>

   <model name="add_to_submenu" resourceBundle="com.ptc.windchill.enterprise.search.client.searchClientResource">
    <description>Actions in submenu Add to</description>
    <action name="addToBaseline" type="baseline" /><!-- Add To Baseline -->
    <action name="add_to_hotlist" type="bookmark" /><!-- Add To Hot Links -->
    <action name="addToManagedCollectionMultiple" type="managedcollection" /> <!-- Add To manage collection -->
    <action name="addToPackageMultiple" type="wpcollection" /><!-- Add To Package -->
    <action name="SBAddToPrj" type="sandbox" shortcut="true" /> <!-- Add to Project -->
   </model>

   <model name="compare_submenu" resourceBundle="com.ptc.windchill.enterprise.search.client.searchClientResource">
    <description>Actions in submenu Compare</description>
    <action name="wtObjCompareMultiple" type="ocmp" /><!-- Information Compare -->
    <action name="multiSelectLaunchStructureCompare" type="structureCompare" /><!-- BOM Structure Compare -->
   </model>

   <model name="process_submenu" resourceBundle="com.ptc.windchill.enterprise.search.client.searchClientResource">
    <description>Actions in of submenu Process</description>
    <action name="reassignLC" type="lifecycle" /> <!--  Reassign Lifecycle -->
    <action name="resetTeam" type="team" />  <!--  Reset Team -->
   </model>
         
   <model name="clfPicker_toolbar">
    <description>Actions on classification node picker JCA tree</description>
    <action name="expandAllClfNode" type="csm" shortcut="true"/> 
    <action name="collapseAllClfNode" type="csm" shortcut="true"/>  
   </model>
   
