<?xml version="1.0"?>
<!DOCTYPE actionmodels SYSTEM 'actionmodels.dtd'>

<actionmodels resourceBundle="com.ptc.windchill.enterprise.supersede.supersedeResource">

  <!-- supersede toolbar -->
  <model name="partSupersedeToolBar" resourceBundle="com.ptc.windchill.enterprise.supersede.supersedeResource">
    <action name="supersedeCollectCadDocuments" type="part" shortcut="true"/>
    <action name="supersedeRemoveObjects" type="part" shortcut="true"/>
    <action name="supersedeSetLocation" type="part" shortcut="true"/>
  </model>
  
  <model name="supersedesTableToolbarActionModel">
    <action name="explode" type="folder" shortcut="true"/>
    <action name="implode" type="folder" shortcut="true"/>    
    <action name="createSupersedeWithExistingWizard" type="supersede" shortcut="true"/>
    <action name="createSupersedeWithNew" type="supersede" shortcut="true"/>
    <action name="undoSupersede" type="part" shortcut="true"/>
  </model>
  
  <model name="supersedesTableRMCActionModel">
    <action name="createSupersedeWithExistingWizard" type="supersede" shortcut="true"/>
    <action name="createSupersedeWithNew" type="supersede" shortcut="true"/>
    <action name="editSupersedeWithExistingWizard" type="supersede" shortcut="true"/>
    <action name="undoSupersede" type="part" shortcut="true"/>
    <action name="supersedeGroupHistory" type="supersede" shortcut="true"/>
  </model>
  
  <model name="supersededTableToolBar">
    <action name="addSupersededObjects" type="supersede" shortcut="true"/>
    <action name="remove" type="object" shortcut="true"/>
  </model>
  
  <model name="supersedingTableToolBar">
    <action name="addSupersedingObjects" type="supersede" shortcut="true"/>
    <action name="remove" type="object" shortcut="true"/>
  </model>

</actionmodels>
