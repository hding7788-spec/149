<?xml version="1.0"?>
<!DOCTYPE listofactions SYSTEM 'actions.dtd'>
<listofactions>
 <objecttype name="object" class="wt.fc.Persistable" resourceBundle="com.ptc.core.security.securityResource">
 	<action name="AccessControlCC" id="AccessControlCC" preloadWizardPage="true" required="true">
     		<command class="" method="" windowType="wizard_step"/>
 	</action>
 	<action name="accessControlOnContext" id="accessControlOnContext" preloadWizardPage="true" required="true">
     		<command class="com.ptc.core.security.delegates.SelectedObjPermissionsUpdateDelegate" method="" windowType="wizard_step"/>
 	</action>
 	<action name="accessControlOnSingle" id="accessControlOnSingle" preloadWizardPage="true" required="true">
     		<command class="com.ptc.core.security.delegates.SelectedObjPermissionsUpdateDelegate" method="" windowType="wizard_step"/>
 	</action>
 	<action name="findParticipant" ajax="row">
     		<command class="com.ptc.windchill.enterprise.picker.principal.PrincipalCommands" method="addPrincipal" windowType="popup"/>
 	</action>
        <action name="removeParticipant" multiselect="true" uicomponent="DELETE" ajax="row" ajaxActionClass="netmarkets/jsp/object/delete.jsp" selectRequired="true">
         	<command class="com.ptc.netmarkets.model.NmObjectCommands" method="list_delete"/>
        </action>
 	<action name="setAccessControlWizStep" id="setAccessControlWizStep" preloadWizardPage="true">
 			<command class="com.ptc.core.security.delegates.UpdatePermissionsFormDelegate" method="" windowType="wizard_step"/>
  	</action>

 	<action name="showMultiObjPermissionStep" id="showMultiObjPermissionStep" required="true" preloadWizardPage="false">
 			<command class="com.ptc.core.security.delegates.MultiUpdatePermissionsFormDelegate" method="" windowType="wizard_step"/>
  	</action>

  	<action name="singleAccessInSharing" id="singleAccessInSharing" preloadWizardPage="false" required="false" hidden="true">
     		<command class="com.ptc.core.security.delegates.UpdateSharingPermissionsFormDelegate" method="" windowType="wizard_step"/>
 	</action>

 	<action name="EDITSECURITYLABELS" selectRequired="true" checkaccess="true" enabledwhensuspended="true" renderType="PDM" uicomponent="EDIT_SECURITY_LABELS">
	 	<command windowType="popup" class="java.lang.Object" method="EDITSECURITYLABELS" />
 	</action>

 	<action name="EDITSECURITYLABELSNONCOLLECTED" selectRequired="true" checkaccess="true" enabledwhensuspended="true" renderType="PDM" uicomponent="EDIT_SECURITY_LABELS">
	 	<command windowType="popup" class="java.lang.Object" method="EDITSECURITYLABELSNONCOLLECTED" />
 	</action>

 	<action name="MULTIEDITSECURITYLABELS" selectRequired="true" checkaccess="true" enabledwhensuspended="true" renderType="PDM" uicomponent="EDIT_SECURITY_LABELS">
	 	<command windowType="popup" class="java.lang.Object" onClick="PTC.security.validateSelectRequired(event)" method="MULTIEDITSECURITYLABELS" />
 	</action>

 </objecttype>

 <objecttype name="accessPermission" class="wt.access.AccessPermission" resourceBundle="com.ptc.core.security.securityResource">
 	<action name="ManageSecurity" uicomponent="EDIT_ACCESS_CONTROL">
 		<command class="com.ptc.core.security.processor.UpdatePermissionsFormProcessor" method="execute" windowType="popup"/>
       		<access name="read"/>
         	<includeFilter name="ghostEpmDoc"/>
 	</action>

 	<action name="ManageSecurityMain" uicomponent="EDIT_ACCESS_CONTROL">
 		<command class="com.ptc.core.security.processor.UpdatePermissionsFormProcessor" method="execute" windowType="popup"/>
       		<access name="read"/>
                <includeFilter name="ghostEpmDoc"/>
 	</action>

 	<action name="multiObjManageSecurityMain" uicomponent="EDIT_ACCESS_CONTROL">
 		<command class="com.ptc.core.security.processor.MultiUpdatePermissionsFormProcessor" method="execute" windowType="popup"/>
       		<access name="read"/>
 	</action>

 	<action name="multiObjManageSecurity" uicomponent="EDIT_ACCESS_CONTROL">
 		<command class="com.ptc.core.security.processor.MultiUpdatePermissionsFormProcessor" method="execute" windowType="popup"/>
       		<access name="read"/>
 	</action>
 	<!-- Use noParentFolderedMultiObjManageSecurity on the Packages->Packages Table -->
 	<action name="noParentFolderedMultiObjManageSecurity" uicomponent="EDIT_ACCESS_CONTROL" selectRequired="true">
 		<command class="com.ptc.core.security.processor.MultiUpdatePermissionsFormProcessor" method="execute" windowType="popup"/>
       		<access name="read"/>
       		<includeFilter name="HideForPackageListTableOnHomePage"/>
 	</action>

 	<!-- Use noParentFolderedMultiObjManageSecurityMain on the Packages->Packages Table -->
 	<action name="noParentFolderedMultiObjManageSecurityMain" uicomponent="EDIT_ACCESS_CONTROL" selectRequired="true">
 		<command class="com.ptc.core.security.processor.MultiUpdatePermissionsFormProcessor" method="execute" windowType="popup"/>
       		<access name="read"/>
       		<includeFilter name="HideForPackageListTableOnHomePage"/>
 	</action>

       	<action name="accessDetails" enabledwhensuspended="true">
          	<command class="" method="accessDetails" windowType="new"/>
       	</action>
       	<action name="mvcAccessDetailsStep" id="mvcAccessDetailsStep" required="true">
        	 <component name="security.acessDetailsRules" windowType="popup" />
       	</action>
    <action name="SecurityApplyButton" id="PJL_wizard_apply">
	         <command class="" method="" windowType="page" url="javascript:onApply();"/>
      </action>
 </objecttype>


