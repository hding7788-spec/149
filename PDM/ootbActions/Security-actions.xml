 	<action name="securityLabelInfo" enabledwhensuspended="true">
          	<command class="" method="securityLabelInfo" windowType="new"/>
    </action>

    <action name="securityLabelInfoStep" id="securityLabelInfoStep" required="true">
		<command windowType="wizard_step"/>
	</action>

    <action name="securityLabelStep" id="securityLabelStep" preloadWizardPage="false" required="true" afterVK="securityLabelStep" >
