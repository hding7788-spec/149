<?xml version="1.0"?>
<!DOCTYPE actionmodels SYSTEM '../../actionmodels.dtd'>

<actionmodels>
    <model name="actionList_details_importJob" menufor="com.ptc.windchill.ixb.importer.ImportJob">
        <action name="delete" type="ixb"/>
        <action name="cancel" type="ixb"/>
    </model>
    <model name="3rdLevelNav_importJob">
        <description>Import Job third level navigation actions</description>
        <submodel name="general" />
        <action name="baselineList"  type="ixb"/>
    </model>
    <model name="importJobInfoPageTabSet" >
        <description>Tab Set for Import Job Info Page</description>
        <submodel name="importJobDetailsTab"/>       
    </model>
    <model name="importJobDetailsTab" resourceBundle="com.ptc.windchill.ixb.importer.importerResource" >
        <description>Import Job Details tab actions</description>
        <action name="primaryAttributes" type="object"/>
        <action name="attributes" type="object"/>
        <action name="primaryContent" type="object"/> 
        <action name="attachments" type="object"/>
        <action name="baselineList"  type="ixb"/>
    </model>
    
   <model name="importJobMonitorTable_action_column" resourceBundle="com.ptc.windchill.ixb.importJobMonitor.importJobMonitorResource">
      <action name="delete"             type="ixb"/>
   </model>

    <model name="importJobMonitorTable_toolbar" resourceBundle="com.ptc.windchill.ixb.importJobMonitor.importJobMonitorResource">
      <action name="refreshImportJobTable"                 type="ixb" shortcut="true" />
      <action name="autoRefreshImportJobTable"             type="ixb" shortcut="true"/>
       <action name="separator"                      type="separator"/>
       <action name="deleteSelectedJobs"             type="ixb" shortcut="true"/>
    </model>
   
	<model name="importFromSpreadsheetWizardButtons" resourceBundle="com.ptc.windchill.ixb.importer.importerResource" >
		<action name="prevButton" type="object"/>
		<action name="nextButton" type="ixb"/>
		<action name="importButton" type="ixb" />
		<action name="cancelButton" type="object"/>
	</model>

	<model name="import_xlsx_error_display_table_toolbar_actions" resourceBundle="com.ptc.windchill.ixb.importer.importerResource">
		
		<action name="stopSpreadsheetValidation" type="ixb" shortcut="true"/>
    </model>
   
	 <model name="ExportSpreadsheetWizardButtons">
		<action name="exportSpreadsheetOkButton" type="ixb"/>
		 <action name="cancelButton" type="object"/>
    </model>
    
    <model name="ExportSpreadsheetSetAttributeWizardButtons">
		<action name="exportSpreadsheetSetAttributeOkButton" type="ixb"/>
		<action name="cancelButton" type="object"/>
    </model>
</actionmodels>
