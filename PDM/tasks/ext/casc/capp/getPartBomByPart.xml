<%@page language="java" access="http|soap" %>
<%@taglib uri="http://www.ptc.com/infoengine/taglib/core" prefix="ie"%>
<%

 String num= (String)getParam("number");
 System.out.println("-----num:"+num);
 
 
 
%>
<ie:webject name="Query-Objects" type="OBJ">
     <ie:param name="INSTANCE" data="$(@FORM[]supporting-adapter[*])" delim="!" valueSeparator="!" default="<%=com.infoengine.au.NamingService.getVMName()%>"/>
    <ie:param name="WHERE" data="(number=<%=num%>)"/>
    <ie:param name="TYPE" data="wt.part.WTPart"/>
    <ie:param name="ATTRIBUTE" data="name"/>
    <ie:param name="ATTRIBUTE" data="number"/>
    <ie:param name="ATTRIBUTE" data="versionInfo.identifier.versionId"/>
    <ie:param name="GROUP_OUT" data="part2"/>
</ie:webject>

<ie:webject name="Sort-Group" type="GRP">
  <ie:param name="GROUP_IN" data="part2"/>
  <ie:param name="SORTBY" data="versionInfo.identifier.versionId"/>
  <ie:param name="CASE_IGNORE" data="TRUE"/>
  <ie:param name="COMPARISON" data="ALPHA"/>
  <ie:param name="SORTED" data="DESC"/>
  <ie:param name="GROUP_OUT" data="part"/>
</ie:webject>

<ie:webject name="Query-Tree" type="OBJ">
