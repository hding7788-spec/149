        <submodel name="rdInfoAttachmentsTab"/>
        <action name="rdChunkInfo" type="rd"/> 
    </model>        
    
    <model name="rdInfoDetailsTab" resourceBundle="com.ptc.windchill.rd.receivedDeliveryResource">
        <action name="primaryAttributes" type="object"/>
